{
  "name": "university-doc-hub",
  "version": "1.0.0",
  "description": "Higher Education Intelligent Document Intake & Decision Hub",
  "main": "backend/src/server.js",
  "scripts": {
    "start": "node backend/src/server.js",
    "server": "node backend/src/server.js",
    "client": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix frontend run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "higher-education",
    "document-intake",
    "decision-hub",
    "gemini-ai",
    "ocr",
    "workflow"
  ],
  "author": "",
  "license": "ISC"
}